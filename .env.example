# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=""          # https://console.anthropic.com

# ── Strava API ─────────────────────────────────────────────
# Erstelle eine App auf https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""           # Numerische ID (z.B. 12345)
STRAVA_CLIENT_SECRET=""       # 40-stelliger Hex-String

# ── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""         # Von @BotFather
TELEGRAM_ALLOWED_USER_ID=""   # Deine Telegram User ID (von @userinfobot)

# ── Datenbank (optional – für Railway) ─────────────────────
# DATABASE_URL=""             # PostgreSQL Connection String (z.B. von Neon.tech)

# ── Strava Tokens (nur für Railway ohne .tokens.json) ──────
# STRAVA_ACCESS_TOKEN=""      # Aus lokaler .tokens.json
# STRAVA_REFRESH_TOKEN=""     # Aus lokaler .tokens.json
# STRAVA_TOKEN_EXPIRES_AT=""  # Unix-Timestamp
